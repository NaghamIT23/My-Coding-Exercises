#include <iostream>
using namespace std;
enum enOpperationType {
    Add='+',Subtract='_',Multiply='*',Divide='/'
 };
float ReadNumber(string Message) {
    int Number1=0;
    cout << Message << endl;
    cin >> Number1;
    return Number1;
}
enOpperationType ReadOpType(){
    char OT;
    cout << "please enter your opperation type (*,_,+,/)" << endl;
    cin >> OT;
    return (enOpperationType)OT;
}
float calculate(float Number1, float Number2, enOpperationType OpType) {
    switch (OpType) {
    case enOpperationType::Add:
            return Number1 + Number2;
    case  enOpperationType::Subtract:
                return Number1-Number2;
    case  enOpperationType::Multiply:
                    return Number1 * Number2;
    case    enOpperationType::Divide:
                        return Number1 / Number2;
                        default : return Number1 + Number2;
    }
}
int main()
{
    float Number1 = ReadNumber("please enter your Number1 ");
    float Number2 = ReadNumber("please enter your Number2");
    enOpperationType OpType = ReadOpType();
    cout << "the result is " << calculate(Number1, Number2, OpType) << endl;
}

