#include <iostream>
using namespace std;

enum enPrimeNoPrime {  prime=1 ,NoPrime=2};
int ReadNumber(string Message) {
    int Number;
    cout << Message << endl;
    cin >> Number;
    return Number;
}
enPrimeNoPrime ChickPrimeNumber(int Number) {
    
    for (int i = 2;i <= 10;i++)
    {
        if (Number % i == 0)
            return enPrimeNoPrime::NoPrime;
        else return enPrimeNoPrime::prime;
    }

}
void printResult(int Number) {
    switch (ChickPrimeNumber(Number)) {
    case enPrimeNoPrime::prime:
        cout << " the number is Prime" << endl;
        break;
    case enPrimeNoPrime::NoPrime:
        cout << "the number is not prime" << endl;
        break;
    }
}
int main()
{
   printResult(ReadNumber("please enter your number  "));
}

