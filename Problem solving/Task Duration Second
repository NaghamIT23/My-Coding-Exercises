#include <iostream>
using namespace std;

struct strTaskDuration {
    int NumberOfDays, NumberOfHouers, NumberOfMinutes, NumberOfSecond;
};
int ReadPositivNumber(string Messag)
{
    int Number;
    cout << Messag << endl;

    cin >> Number;
    return Number;

}
strTaskDuration ReadTaskDuration() {
    strTaskDuration TaskDuration;
    TaskDuration.NumberOfHouers = ReadPositivNumber("please enter your  houer");
    TaskDuration.NumberOfDays = ReadPositivNumber("please enter your day");
    TaskDuration.NumberOfMinutes = ReadPositivNumber("please enter your minute");
    TaskDuration.NumberOfSecond = ReadPositivNumber("please enter your second");
    return TaskDuration;

}
int TaskDurationSecond(strTaskDuration TaskDuration) {
    int DurationOSecond = 0;
    DurationOSecond = TaskDuration.NumberOfDays * 24 * 60*60;
    DurationOSecond += TaskDuration.NumberOfHouers * 60 * 60;
    DurationOSecond += TaskDuration.NumberOfMinutes * 60;
    DurationOSecond += TaskDuration.NumberOfSecond;
    return DurationOSecond;
}
int main() 
    {
    cout << " \nthe calculat of secont = " << TaskDurationSecond(ReadTaskDuration());
    cout << endl;
    }


