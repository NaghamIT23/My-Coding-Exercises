#include <iostream>
using namespace std;
void readmark(int& mark1, int& mark2, int& mark3) {
    cout << "please enter your mark1" << endl;
    cin >> mark1;
    cout << "please enter your mark2" << endl;
    cin >> mark2;
    cout << "please enter your mark3" << endl;
    cin >> mark3;
}
int sumof3mark(int mark1,int mark2, int mark3) {
    return mark1 + mark2 + mark3;
}
float avrgof3mark(int mark1, int mark2, int mark3) {
    return (float)sumof3mark(mark1, mark2, mark3) / 3;
}
void printresult(float avereg) {
    cout << "the averg is" << avereg;
}

int main()
{
    int mark1, mark2, mark3;
    readmark(mark1, mark2, mark3);
    printresult(avrgof3mark(mark1,mark2,mark3));
}

