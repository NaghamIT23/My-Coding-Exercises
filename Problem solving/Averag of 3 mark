#include <iostream>
using namespace std;
enum enpassfail{ pass=1 , fai=2};

void Readmark(int& mark1, int& mark2, int& mark3) {
    cout << "pleas enter your mark1" << endl;
    cin >> mark1;
    cout << "pleas enter your mark2" << endl;
    cin >> mark2;
    cout << "pleas enter your mark3" << endl;
    cin >> mark3;

}
int sumof3mark(int mark1, int mark2, int mark3) {
    return mark1 + mark2 + mark3;
}
float calculateaverag(int mark1, int mark2, int mark3) {
    return (float)sumof3mark(mark1, mark2, mark3) / 3;
}
enpassfail checkaverage(float averg) {
    if (averg >= 50)
        return enpassfail::pass;
    else
        return enpassfail::fai;
}
void printresult(float averg) {
    cout << "your averg is " << averg << endl;

    if (checkaverage(averg) == enpassfail::pass)
        cout << "you passed" << endl;
    else cout << " you faild" << endl;
}

int main()
{
    int mark1, mark2, mark3;
    Readmark(mark1, mark2, mark3);
    printresult(calculateaverag(mark1, mark2, mark3));
}
