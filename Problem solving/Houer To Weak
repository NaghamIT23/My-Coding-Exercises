#include <iostream>
using namespace std;

float ReadNumberHouer(string Message) {
    float NumberHouer;
    cout << "please enter your number of houer" << endl;
    cin >> NumberHouer;
    return NumberHouer;
}
float HouerToDay(float NumberHouer) {
    return NumberHouer / 24;
}
float HouerToWeak(float NumberHouer) {
    return NumberHouer / 24 / 7;
}
float DayToWeak(float NumberDay) {
    return NumberDay / 7;
}
int main()
{
    float NumberOfHouer = ReadNumberHouer("please enter your number of houer");
    float NumberOfDay = HouerToDay(NumberOfHouer);
    float NumberOfWeake = DayToWeak(NumberOfDay);

    cout << endl;
    cout << "number of houer = " << NumberOfHouer << endl;
    cout << "number of day = " << NumberOfDay << endl;
    cout << "number of weake = " << NumberOfWeake << endl;
}

